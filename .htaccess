# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Apache Reverse Proxy Configuration for Next.js (Production)
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

RewriteEngine On

# 1. Allow Apache to serve physical files in htdocs if they exist
# (e.g. robots.txt, sitemap.xml, or custom static files placed here)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Forward all other requests to the Next.js server running on port 6918
# Ensure that Apache modules 'mod_proxy', 'mod_proxy_http', and 'mod_rewrite' are enabled.
RewriteRule ^(.*)$ http://127.0.0.1:6918/$1 [P,L]
